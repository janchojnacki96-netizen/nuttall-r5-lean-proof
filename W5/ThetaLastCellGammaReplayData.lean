def thetaLastCellBinLower (i : Fin 12) (k : Fin 9) : ℚ :=
  (((thetaLastCellBinLowerData[i.val]!)[k.val]! : ℤ):ℚ)/10000000000000000

def thetaLastCellBinUpper (i : Fin 12) (k : Fin 9) : ℚ :=
  (((thetaLastCellBinUpperData[i.val]!)[k.val]! : ℤ):ℚ)/10000000000000000

def thetaLastCellBinStart (i : Fin 12) : ℚ := ((4*i.val:ℕ):ℚ)
def thetaLastCellBinEnd (i : Fin 12) : ℚ := ((4*(i.val+1):ℕ):ℚ)

/-- Each bin check uses the stored exponential table. Only one
left lower and one right upper integral are needed per degree. -/
def ThetaLastCellGammaBinFits (i : Fin 12) : Prop :=
  let L := thetaLastCellBinStart i
  let U := thetaLastCellBinEnd i
  let BLo := thetaGammaMemoLowerNineBin thetaLastCellWExp 8
    (thetaLastCellA^2) L U
  let BHi := thetaGammaMemoUpperNineBin thetaLastCellWExp 8
    (thetaLastCellB^2) L U
  ∀ k : Fin 9,
    thetaLastCellBinLower i k ≤ (BLo k).lo ∧
    (BHi k).hi ≤ thetaLastCellBinUpper i k

instance (i : Fin 12) : Decidable (ThetaLastCellGammaBinFits i) := by
  unfold ThetaLastCellGammaBinFits
  infer_instance

-- Match the original right-associated recursive grid sums.
def thetaLastCellBinLowerSum (k : Fin 9) : ℚ :=
  thetaLastCellBinLower (0:Fin 12) k + (thetaLastCellBinLower (1:Fin 12) k + (thetaLastCellBinLower (2:Fin 12) k + (thetaLastCellBinLower (3:Fin 12) k + (thetaLastCellBinLower (4:Fin 12) k + (thetaLastCellBinLower (5:Fin 12) k + (thetaLastCellBinLower (6:Fin 12) k + (thetaLastCellBinLower (7:Fin 12) k + (thetaLastCellBinLower (8:Fin 12) k + (thetaLastCellBinLower (9:Fin 12) k + (thetaLastCellBinLower (10:Fin 12) k + (thetaLastCellBinLower (11:Fin 12) k + 0)))))))))))

def thetaLastCellBinUpperSum (k : Fin 9) : ℚ :=
  thetaLastCellBinUpper (0:Fin 12) k + (thetaLastCellBinUpper (1:Fin 12) k + (thetaLastCellBinUpper (2:Fin 12) k + (thetaLastCellBinUpper (3:Fin 12) k + (thetaLastCellBinUpper (4:Fin 12) k + (thetaLastCellBinUpper (5:Fin 12) k + (thetaLastCellBinUpper (6:Fin 12) k + (thetaLastCellBinUpper (7:Fin 12) k + (thetaLastCellBinUpper (8:Fin 12) k + (thetaLastCellBinUpper (9:Fin 12) k + (thetaLastCellBinUpper (10:Fin 12) k + (thetaLastCellBinUpper (11:Fin 12) k + 0)))))))))))

def thetaLastCellGammaFastBox (k : Fin 9) : QInterval :=
  ⟨thetaLastCellBinLowerSum k,
    thetaLastCellBinUpperSum k +
      (thetaLastCellWExp 48).hi *
        (thetaGammaBinPolyQ k.val 48 +
          (thetaLastCellB^2/4)*thetaGammaBinPolyQ (k.val+1) 48)⟩

def ThetaLastCellGammaMomentSumsFit : Prop :=
  ∀ k : Fin 9,
    (thetaLastCellReplayMomentWitness k.val).lo ≤
      (thetaLastCellGammaFastBox k).lo ∧
    (thetaLastCellGammaFastBox k).hi ≤
      (thetaLastCellReplayMomentWitness k.val).hi

instance : Decidable ThetaLastCellGammaMomentSumsFit := by
  unfold ThetaLastCellGammaMomentSumsFit
  infer_instance

