import W5.ThetaAuditedCorrectionWPolynomial

/-!
# Monotone genuine weighted theta moments on audited cells

The original 768-bit auditor encloses nine weighted Lebesgue moments
  M_k(x) = ∫_{w≥0} e^(-w) (1+w*x²)^(1/4) w^k dw.
The entire x-cell can be enclosed by values at its two endpoints,
because each true M_k(x) is monotone increasing for x≥0.

This file reuses:
* the genuine integral definition and proved Gamma domination;
* the *existing* exact Gamma-integrability and evaluation lemmas;
* Mathlib's rpow_le_rpow and integral_mono_ae;
* the existing QInterval.ContainsReal semantics.

No moment values generated by an external program are assumed sound:
the endpoint bounds remain explicit premises. The first audited cell
starts at x=0, so we also prove M_k(0)=k! using the EXISTING Gamma
formula and establish integrability at x=0 without any limit argument.
-/

namespace W5
open MeasureTheory

/-- Gamma integrability extends the existing genuine moment
integrability proof to x=0, where the fourth-root weight equals one. -/
theorem thetaAuditedOneWeightedMoment_integrable_nonneg
    (x : ℝ) (hx : 0 ≤ x) (hx1 : x ≤ 1) (k : ℕ) :
    IntegrableOn
      (fun w : ℝ =>
        (Real.exp (-w) * (1+w*x^2)^((1 : ℝ)/4)) * w^k)
      (Set.Ici (0 : ℝ)) volume := by
  rcases eq_or_lt_of_le hx with hz | hpos
  · rw [← hz]
    have hΓ : IntegrableOn
        (fun w : ℝ => w^k * Real.exp (-w))
        (Set.Ici (0 : ℝ)) volume :=
      (integrableOn_Ici_iff_integrableOn_Ioi).2
        (thetaAuditedCorrectionGammaMoment_integrable k)
    exact hΓ.congr_fun
      (fun w _ => by simp [mul_comm]) measurableSet_Ici
  · exact thetaAuditedOneWeightedMoment_integrable x hpos hx1 k

/-- For x≥0 every original theta moment is monotone in x.
This is a genuine Lebesgue-integral inequality; it uses
Mathlib's rpow monotonicity and Bochner integral_mono_ae. -/
theorem thetaAuditedOneWeightedMoment_mono
    (a b : ℝ) (ha : 0 ≤ a) (hab : a ≤ b)
    (hb : b ≤ 1) (k : ℕ) :
    thetaAuditedOneWeightedMoment a k ≤
      thetaAuditedOneWeightedMoment b k := by
  have hb0 : 0 ≤ b := ha.trans hab
  have ha1 : a ≤ 1 := hab.trans hb
  have hsq : a^2 ≤ b^2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hab)
      (add_nonneg ha hb0)]
  unfold thetaAuditedOneWeightedMoment
  apply integral_mono_ae
    (thetaAuditedOneWeightedMoment_integrable_nonneg a ha ha1 k)
    (thetaAuditedOneWeightedMoment_integrable_nonneg b hb0 hb k)
  filter_upwards [ae_restrict_mem measurableSet_Ici] with w hw
  have hw0 : 0 ≤ w := hw
  have hbase : 1+w*a^2 ≤ 1+w*b^2 := by
    nlinarith [mul_nonneg hw0 (sub_nonneg.mpr hsq)]
  have hroot :
      (1+w*a^2)^((1 : ℝ)/4) ≤
        (1+w*b^2)^((1 : ℝ)/4) :=
    Real.rpow_le_rpow (by positivity) hbase (by norm_num)
  exact mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left hroot (Real.exp_nonneg _))
    (pow_nonneg hw0 k)

/-- Exact base point of each genuine weighted moment, with
NO numerical approximation: M_k(0)=k! by Mathlib's Gamma integral. -/
theorem thetaAuditedOneWeightedMoment_zero (k : ℕ) :
    thetaAuditedOneWeightedMoment 0 k = (Nat.factorial k : ℝ) := by
  have hpoint (w : ℝ) :
      (Real.exp (-w) * (1+w*(0 : ℝ)^2)^((1 : ℝ)/4)) * w^k =
        w^k * Real.exp (-w) := by
    simp [mul_comm]
  unfold thetaAuditedOneWeightedMoment
  simp_rw [hpoint]
  rw [integral_Ici_eq_integral_Ioi]
  exact thetaAuditedCorrectionGammaMoment k

/-- It suffices to certify each moment at just TWO x-cell
endpoints. The rational lower endpoint of the first interval and
the rational upper endpoint of the second interval then enclose
the moment at EVERY interior x, even when a=0. -/
theorem thetaAuditedOneWeightedMoment_cell_interval
    (a x b : ℝ) (ha : 0 ≤ a) (hax : a ≤ x)
    (hxb : x ≤ b) (hb : b ≤ 1)
    (k : ℕ) (A B : QInterval)
    (hA : QInterval.ContainsReal A
      (thetaAuditedOneWeightedMoment a k))
    (hB : QInterval.ContainsReal B
      (thetaAuditedOneWeightedMoment b k)) :
    QInterval.ContainsReal ⟨A.lo, B.hi⟩
      (thetaAuditedOneWeightedMoment x k) := by
  change (A.lo : ℝ) ≤ thetaAuditedOneWeightedMoment x k ∧
      thetaAuditedOneWeightedMoment x k ≤ (B.hi : ℝ)
  constructor
  · exact hA.1.trans
      (thetaAuditedOneWeightedMoment_mono a x
        ha hax (hxb.trans hb) k)
  · exact
      (thetaAuditedOneWeightedMoment_mono x b
        (ha.trans hax) hxb hb k).trans hB.2

/-- In the FIRST x-cell the lower endpoint is exactly k!:
only the nine upper-endpoint moments at b=1/8 need separate
rigorous numerical enclosures to get a (possibly coarse)
uniform moment bound. -/
theorem thetaAuditedOneWeightedMoment_first_cell_interval
    (x b : ℝ) (hx : 0 ≤ x)
    (hxb : x ≤ b) (hb : b ≤ 1)
    (k : ℕ) (B : QInterval)
    (hB : QInterval.ContainsReal B
      (thetaAuditedOneWeightedMoment b k)) :
    QInterval.ContainsReal ⟨(Nat.factorial k : ℚ), B.hi⟩
      (thetaAuditedOneWeightedMoment x k) := by
  change ((Nat.factorial k : ℚ) : ℝ) ≤
      thetaAuditedOneWeightedMoment x k ∧
      thetaAuditedOneWeightedMoment x k ≤ (B.hi : ℝ)
  have hlow := thetaAuditedOneWeightedMoment_mono
    0 x (le_refl 0) hx (hxb.trans hb) k
  have hhigh := thetaAuditedOneWeightedMoment_mono
    x b hx hxb hb k
  constructor
  · simpa only [thetaAuditedOneWeightedMoment_zero,
      Rat.cast_natCast] using hlow
  · exact hhigh.trans hB.2

end W5
