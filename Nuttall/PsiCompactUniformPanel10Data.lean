def psiOneUniformPanel10Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel10 : QInterval :=
  bounds 114022666897933066999030 114022666897933510002720

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (10/32) ∧ psiPreciseGridInputs (10/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel10Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel10Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel10Jet j).ContainsReal (iteratedDeriv j Phi ((10/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel10_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel10Jet 36 (1/32)
    psiOneUniformPanel10.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel10.hi := by
  decide +kernel

#print axioms psiOneUniformPanel10Jet_containsReal
#print axioms psiOneUniformPanel10_checked

