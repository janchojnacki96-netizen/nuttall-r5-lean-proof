noncomputable def phiRankEightJet (x : ℝ) (j : ℕ) : ℝ :=
  compactFixedRealEval (phiRankEightJetCoefficients j) x

set_option maxRecDepth 32768 in
set_option maxHeartbeats 6000000 in
private theorem phiRankEightJetCoefficients_eq (j : ℕ) (hj : j < 15) :
    phiRankEightJetCoefficients j =
      List.ofFn (fun k : Fin (j+2) => (phiJetCoeffRow j)[k.val]) := by
  interval_cases j <;> decide +kernel

theorem phiRankEightJet_eq_eval (x : ℝ) (j : ℕ) (hj : j < 15) :
    (phiJetPolynomial j).eval x = phiRankEightJet x j := by
  rw [phiRankEightJet, phiRankEightJetCoefficients_eq j hj, compactFixedRealEval_ofFn,
    eval_phiJetPolynomial_of_lt (show j+1 < j+2 by omega)]
  simp only [phiJetCoeffRow_getElem]
  exact (Fin.sum_univ_eq_sum_range (fun k => (phiJetCoeff j k:ℝ)*x^k) (j+2)).symm

#print axioms phiRankEightRows_det_pos
#print axioms phiRankEightJet_eq_eval

