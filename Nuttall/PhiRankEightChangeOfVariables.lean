/-- Row coefficients of the gauged logarithmic change of variables, through degree seven. -/
noncomputable def phiRankEightRow (X : ℝ) : ℕ → ℕ → ℝ
  | 0, 0 => (1:ℝ)
  | 1, 0 => (-5/4:ℝ) + (1:ℝ)*X^1
  | 1, 1 => (1/4:ℝ)
  | 2, 0 => (45/32:ℝ) + (-5/4:ℝ)*X^1 + (1/2:ℝ)*X^2
  | 2, 1 => (-7/16:ℝ) + (1/4:ℝ)*X^1
  | 2, 2 => (1/32:ℝ)
  | 3, 0 => (-195/128:ℝ) + (45/32:ℝ)*X^1 + (-5/8:ℝ)*X^2 + (1/6:ℝ)*X^3
  | 3, 1 => (227/384:ℝ) + (-7/16:ℝ)*X^1 + (1/8:ℝ)*X^2
  | 3, 2 => (-9/128:ℝ) + (1/32:ℝ)*X^1
  | 3, 3 => (1/384:ℝ)
  | 4, 0 => (3315/2048:ℝ) + (-195/128:ℝ)*X^1 + (45/64:ℝ)*X^2 + (-5/24:ℝ)*X^3 + (1/24:ℝ)*X^4
  | 4, 1 => (-1111/1536:ℝ) + (227/384:ℝ)*X^1 + (-7/32:ℝ)*X^2 + (1/24:ℝ)*X^3
  | 4, 2 => (343/3072:ℝ) + (-9/128:ℝ)*X^1 + (1/64:ℝ)*X^2
  | 4, 3 => (-11/1536:ℝ) + (1/384:ℝ)*X^1
  | 4, 4 => (1/6144:ℝ)
  | 5, 0 => (-13923/8192:ℝ) + (3315/2048:ℝ)*X^1 + (-195/256:ℝ)*X^2 + (15/64:ℝ)*X^3 + (-5/96:ℝ)*X^4 + (1/120:ℝ)*X^5
  | 5, 1 => (34423/40960:ℝ) + (-1111/1536:ℝ)*X^1 + (227/768:ℝ)*X^2 + (-7/96:ℝ)*X^3 + (1/96:ℝ)*X^4
  | 5, 2 => (-1885/12288:ℝ) + (343/3072:ℝ)*X^1 + (-9/256:ℝ)*X^2 + (1/192:ℝ)*X^3
  | 5, 3 => (161/12288:ℝ) + (-11/1536:ℝ)*X^1 + (1/768:ℝ)*X^2
  | 5, 4 => (-13/24576:ℝ) + (1/6144:ℝ)*X^1
  | 5, 5 => (1/122880:ℝ)
  | 6, 0 => (116025/65536:ℝ) + (-13923/8192:ℝ)*X^1 + (3315/4096:ℝ)*X^2 + (-65/256:ℝ)*X^3 + (15/256:ℝ)*X^4 + (-1/96:ℝ)*X^5 + (1/720:ℝ)*X^6
  | 6, 1 => (-93019/98304:ℝ) + (34423/40960:ℝ)*X^1 + (-1111/3072:ℝ)*X^2 + (227/2304:ℝ)*X^3 + (-7/384:ℝ)*X^4 + (1/480:ℝ)*X^5
  | 6, 2 => (574519/2949120:ℝ) + (-1885/12288:ℝ)*X^1 + (343/6144:ℝ)*X^2 + (-3/256:ℝ)*X^3 + (1/768:ℝ)*X^4
  | 6, 3 => (-985/49152:ℝ) + (161/12288:ℝ)*X^1 + (-11/3072:ℝ)*X^2 + (1/2304:ℝ)*X^3
  | 6, 4 => (647/589824:ℝ) + (-13/24576:ℝ)*X^1 + (1/12288:ℝ)*X^2
  | 6, 5 => (-1/32768:ℝ) + (1/122880:ℝ)*X^1
  | 6, 6 => (1/2949120:ℝ)
  | 7, 0 => (-480675/262144:ℝ) + (116025/65536:ℝ)*X^1 + (-13923/16384:ℝ)*X^2 + (1105/4096:ℝ)*X^3 + (-65/1024:ℝ)*X^4 + (3/256:ℝ)*X^5 + (-1/576:ℝ)*X^6 + (1/5040:ℝ)*X^7
  | 7, 1 => (5743177/5505024:ℝ) + (-93019/98304:ℝ)*X^1 + (34423/81920:ℝ)*X^2 + (-1111/9216:ℝ)*X^3 + (227/9216:ℝ)*X^4 + (-7/1920:ℝ)*X^5 + (1/2880:ℝ)*X^6
  | 7, 2 => (-2778803/11796480:ℝ) + (574519/2949120:ℝ)*X^1 + (-1885/24576:ℝ)*X^2 + (343/18432:ℝ)*X^3 + (-3/1024:ℝ)*X^4 + (1/3840:ℝ)*X^5
  | 7, 3 => (326917/11796480:ℝ) + (-985/49152:ℝ)*X^1 + (161/24576:ℝ)*X^2 + (-11/9216:ℝ)*X^3 + (1/9216:ℝ)*X^4
  | 7, 4 => (-4369/2359296:ℝ) + (647/589824:ℝ)*X^1 + (-13/49152:ℝ)*X^2 + (1/36864:ℝ)*X^3
  | 7, 5 => (167/2359296:ℝ) + (-1/32768:ℝ)*X^1 + (1/245760:ℝ)*X^2
  | 7, 6 => (-17/11796480:ℝ) + (1/2949120:ℝ)*X^1
  | 7, 7 => (1/82575360:ℝ)
  | _, _ => 0

theorem phiRankEightRow_zero {X : ℝ} {i j : ℕ} (hi : i < 8) (hij : i < j) :
    phiRankEightRow X i j = 0 := by
  by_cases hj : j < 8
  · interval_cases i <;> interval_cases j <;> first | omega | rfl
  · obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le (show 8 ≤ j by omega)
    rw [show j = k+8 by omega]
    interval_cases i <;> rfl

noncomputable def phiRankEightRows (p : ℕ) (X : ℝ) : Matrix (Fin p) (Fin p) ℝ :=
  Matrix.of fun i j => phiRankEightRow X i.val j.val

theorem phiRankEightRows_det_pos {p : ℕ} (hp : p ≤ 8) (X : ℝ) :
    0 < (phiRankEightRows p X).det := by
  rw [Matrix.det_of_isLowerTriangular]
  · apply Finset.prod_pos
    intro i _
    have hi : i.val < 8 := i.isLt.trans_le hp
    let k := i.val
    change k < 8 at hi
    change 0 < phiRankEightRow X k k
    interval_cases k <;> norm_num [phiRankEightRow]
  · intro i j hij
    exact phiRankEightRow_zero (i.isLt.trans_le hp) hij

