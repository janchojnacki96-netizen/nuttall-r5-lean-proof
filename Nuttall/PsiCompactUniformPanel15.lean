def psiOneUniformPanel15Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel15 : QInterval :=
  bounds 23435112120816291194 23435112121260799299

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (15/32) ∧ psiPreciseGridInputs (15/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel15Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel15Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel15Jet j).ContainsReal (iteratedDeriv j Phi ((15/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel15_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel15Jet 36 (1/32)
    psiOneUniformPanel15.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel15.hi := by
  decide +kernel

/-- One more shared anchor to the left of 1/2, at 15/32. -/
def psiOneCompactFifteen32Anchor : QInterval :=
  psiOneCompactHalfAnchor.add psiOneUniformPanel15

theorem psiOneCompactFifteen32Anchor_containsReal :
    psiOneCompactFifteen32Anchor.ContainsReal (psi 1 ((15/32:ℚ):ℝ)) := by
  have hright : psiOneCompactHalfAnchor.ContainsReal (psi 1 (((16:ℕ):ℝ)/32)) := by
    simpa only [show ((16:ℕ):ℝ)/32 = (1/2:ℝ) by norm_num] using psiOneCompactHalfAnchor_containsReal
  have h := psiOneCompactShortPanel_containsReal (center := 15/32) (anchor := 16)
    (by norm_num) (by norm_num) (by decide) hright psiOneUniformPanel15Jet_containsReal
  rw [show ((16:ℕ):ℚ)/32-15/32 = 1/32 by norm_num, psiOnePanelBox_eq_add_zero] at h
  have hb := psiOneUniformPanel15_checked
  exact compactContainsReal_of_endpoints (add_le_add (le_refl psiOneCompactHalfAnchor.lo) hb.1)
    (add_le_add (le_refl psiOneCompactHalfAnchor.hi) hb.2) h

#print axioms psiOneUniformPanel15Jet_containsReal
#print axioms psiOneUniformPanel15_checked
#print axioms psiOneCompactFifteen32Anchor_containsReal

end Nuttall
