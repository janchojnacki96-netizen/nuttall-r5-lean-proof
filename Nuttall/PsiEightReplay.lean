private theorem cornerChain : SchurIntervalChain 8 psiEightWitnessBox cornerDetBox := by
  unfold cornerDetBox
  refine SchurIntervalChain.step psiEightWitnessBox corner7 _
    (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step corner7 corner6 _ (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step corner6 corner5 _ (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step corner5 corner4 _ (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step corner4 corner3 _ (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step corner3 corner2 _ (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step corner2 corner1 _ (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step corner1 (rankEightBlock 0 #[]) _
    (by decide +kernel) (by decide +kernel) ?_
  exact SchurIntervalChain.empty _

