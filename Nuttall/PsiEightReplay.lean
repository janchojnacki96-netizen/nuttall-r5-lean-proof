private theorem cofactorChain :
    SchurIntervalChain 7 (psiEightWitnessBox.submatrix Fin.succ Fin.succ) cofactorDetBox := by
  unfold cofactorDetBox
  refine SchurIntervalChain.step (psiEightWitnessBox.submatrix Fin.succ Fin.succ) cofactor6 _
    (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step cofactor6 cofactor5 _ (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step cofactor5 cofactor4 _ (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step cofactor4 cofactor3 _ (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step cofactor3 cofactor2 _ (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step cofactor2 cofactor1 _ (by decide +kernel) (by decide +kernel) ?_
  refine SchurIntervalChain.step cofactor1 (rankEightBlock 0 #[]) _
    (by decide +kernel) (by decide +kernel) ?_
  exact SchurIntervalChain.empty _

/-- The rank-eight Wronskian of the first tail integral has the wrong sign at 5/64. -/
theorem psiOne_wronskian_at_rankEight_witness_neg : wronskian (psi 1) 8 (5/64) < 0 :=
  psiOne_wronskian_at_rankEight_witness_neg_of_schur
    psiEightWitnessBox_containsReal cornerChain cofactorChain
    (by decide +kernel) (by decide +kernel)

/-- The rank-eight minimum requires at least two tail integrations. -/
theorem two_le_kernelIntegrationOrder_eight : 2 ≤ kernelIntegrationOrder 8 :=
  two_le_kernelIntegrationOrder_of_rankEight_wronskian psiOne_wronskian_at_rankEight_witness_neg

#print axioms psiOne_wronskian_at_rankEight_witness_neg
#print axioms two_le_kernelIntegrationOrder_eight

