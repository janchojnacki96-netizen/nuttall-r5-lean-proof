private def psiEightWitnessBox : Matrix (Fin 8) (Fin 8) QInterval :=
  Matrix.of (fun i j => fixedBox jetBounds[i.val+j.val]!)

set_option maxRecDepth 32768 in
set_option maxHeartbeats 12000000 in
private theorem jetBounds_enclose_raw {j : ℕ} (hj : j ≤ 13) :
    let box := fixedBox jetBounds[j+1]!
    box.lo ≤ (psiEightJetRawBox j).lo ∧ (psiEightJetRawBox j).hi ≤ box.hi := by
  interval_cases j <;> decide +kernel

private theorem psiEightWitnessBox_containsReal (i j : Fin 8) :
    (psiEightWitnessBox i j).ContainsReal
      (replaceMatrixCorner psiEightWitnessHankel (29/1000) i j) := by
  by_cases h : i.val + j.val = 0
  · have hi : i = 0 := by apply Fin.ext; simp; omega
    have hj : j = 0 := by apply Fin.ext; simp; omega
    subst i
    subst j
    norm_num [psiEightWitnessBox, replaceMatrixCorner, jetBounds, fixedBox, QInterval.ContainsReal]
  · have h' : i.val + j.val - 1 + 1 = i.val + j.val := by omega
    have hbound : i.val + j.val - 1 ≤ 13 := by omega
    have hbox := jetBounds_enclose_raw hbound
    have hjets := psiEightJetRawBox_containsReal hbound
    dsimp only at hbox
    rw [h'] at hbox hjets
    have hi : ¬(i = 0 ∧ j = 0) := by
      rintro ⟨rfl, rfl⟩
      exact h rfl
    simp only [replaceMatrixCorner, ite_eq_right hi, psiEightWitnessHankel, psiEightWitnessBox, Matrix.of_apply]
    exact ⟨(Rat.cast_mono hbox.1).trans hjets.1, hjets.2.trans (Rat.cast_mono hbox.2)⟩

/-- A round-out of a symmetric Schur block, stored in lower triangular order. -/
private def rankEightBlock (n : ℕ) (data : Array (ℤ × ℤ)) :
    Matrix (Fin n) (Fin n) QInterval :=
  Matrix.of fun i j =>
    let row := max i.val j.val
    let col := min i.val j.val
    fixedBox data[row * (row + 1) / 2 + col]!

