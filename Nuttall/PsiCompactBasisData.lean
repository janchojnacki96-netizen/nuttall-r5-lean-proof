def psiOneCompactBasis (cell : Fin 67) : Matrix (Fin 7) (Fin 7) ℚ :=
  Matrix.of fun i j => if i < j then 0 else ((((psiOneCompactBasisNumerators.get cell).get i).get j:ℤ):ℚ)/1024

theorem psiOneCompactBasis_lower (cell : Fin 67) : (psiOneCompactBasis cell).IsLowerTriangular := by
  intro i j hij
  change i < j at hij
  simp [psiOneCompactBasis, hij]

set_option maxRecDepth 32768 in
set_option maxHeartbeats 6000000 in
theorem psiOneCompactBasis_diagonal_ne_zero (cell : Fin 67) (i : Fin 7) :
    psiOneCompactBasis cell i i ≠ 0 := by
  have h : ∀ c : Fin 67, ∀ j : Fin 7, psiOneCompactBasis c j j ≠ 0 := by decide +kernel
  exact h cell i

set_option maxRecDepth 32768 in
set_option maxHeartbeats 8000000 in
theorem psiOneCompactBasis_row_le (cell : Fin 67) (i : Fin 7) :
    (∑ j, |psiOneCompactBasis cell i j|) ≤ 20000000 := by
  have h : ∀ c : Fin 67, ∀ i : Fin 7, (∑ j, |psiOneCompactBasis c i j|) ≤ 20000000 := by
    decide +kernel
  exact h cell i

#print axioms psiOneCompactBasis_lower
#print axioms psiOneCompactBasis_diagonal_ne_zero
#print axioms psiOneCompactBasis_row_le

end Nuttall
