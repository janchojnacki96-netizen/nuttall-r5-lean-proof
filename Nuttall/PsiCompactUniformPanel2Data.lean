def psiOneUniformPanel2Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel2 : QInterval :=
  bounds 13675768671108335420361023 13675768671108335863547129

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (2/32) ∧ psiPreciseGridInputs (2/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel2Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel2Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel2Jet j).ContainsReal (iteratedDeriv j Phi ((2/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel2_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel2Jet 36 (1/32)
    psiOneUniformPanel2.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel2.hi := by
  decide +kernel

#print axioms psiOneUniformPanel2Jet_containsReal
#print axioms psiOneUniformPanel2_checked

