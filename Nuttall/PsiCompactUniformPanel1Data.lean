def psiOneUniformPanel1Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel1 : QInterval :=
  bounds 15866404383463250113057386 15866404383463250556249452

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (1/32) ∧ psiPreciseGridInputs (1/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel1Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel1Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel1Jet j).ContainsReal (iteratedDeriv j Phi ((1/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel1_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel1Jet 36 (1/32)
    psiOneUniformPanel1.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel1.hi := by
  decide +kernel

#print axioms psiOneUniformPanel1Jet_containsReal
#print axioms psiOneUniformPanel1_checked

end Nuttall
