def psiOneUniformPanel8Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel8 : QInterval :=
  bounds 802732991463687908633624 802732991463688351547343

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (8/32) ∧ psiPreciseGridInputs (8/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel8Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel8Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel8Jet j).ContainsReal (iteratedDeriv j Phi ((8/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel8_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel8Jet 36 (1/32)
    psiOneUniformPanel8.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel8.hi := by
  decide +kernel

#print axioms psiOneUniformPanel8Jet_containsReal
#print axioms psiOneUniformPanel8_checked

