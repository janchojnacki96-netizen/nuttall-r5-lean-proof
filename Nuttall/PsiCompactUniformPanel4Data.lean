def psiOneUniformPanel4Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel4 : QInterval :=
  bounds 7956687792221117035800236 7956687792221117478925114

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (4/32) ∧ psiPreciseGridInputs (4/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel4Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel4Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel4Jet j).ContainsReal (iteratedDeriv j Phi ((4/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel4_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel4Jet 36 (1/32)
    psiOneUniformPanel4.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel4.hi := by
  decide +kernel

#print axioms psiOneUniformPanel4Jet_containsReal
#print axioms psiOneUniformPanel4_checked

