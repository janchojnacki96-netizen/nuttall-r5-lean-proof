import Nuttall.PsiPreciseGridJets

namespace Nuttall

open W5

def psiLastCellNode (i : Fin 7) : ℚ :=
  (#v[255/512, 1/2, 17/32, 9/16, 19/32, 5/8, 21/32] : Vector ℚ 7).get i

private def lastCellInputEndpoints : Vector ((ℤ × ℤ) × (ℤ × ℤ) × (ℤ × ℤ)) 7 := #v[
  ((2037035601593973884552884160, 2037035601593973884552917681), (28513171129270891589834753944, 28513171129270891589927604650), (122942116128005775, 122942116128018155)),
  ((2041018074621158724879250894, 2041018074621158724879284545), (28736802702101849249116666137, 28736802702101849249210261605), (102623350865245529, 102623350865257910)),
  ((2105806943076892109572358067, 2105806943076892109572393889), (32563063527973305007098380328, 32563063527973305007204758255), (4665694125366156, 4665694125378536)),
  ((2172652430985421597872656304, 2172652430985421597872694436), (36898785063839742394334251701, 36898785063839742394455205045), (140558522419559, 140558522431940)),
  ((2241619822456107878046897725, 2241619822456107878046938317), (41811801215135320235338444913, 41811801215135320235476031206), (2656265236316, 2656265248697)),
  ((2312776473938398290672709033, 2312776473938398290672752242), (47378977866868236985529456159, 47378977866868236985686040075), (29593266124, 29593278504)),
  ((2386191880004962675968603509, 2386191880004962675968649505), (53687415477729145280952255964, 53687415477729145281130559638), (181160145, 181172525))
]

private def lastCellInputBox (a : ℤ × ℤ) : QInterval :=
  ⟨(a.1:ℚ)/(2^90), (a.2:ℚ)/(2^90)⟩

def psiLastCellGridInputs (i : Fin 7) : PsiPreciseGridInputs :=
  let values := lastCellInputEndpoints.get i
  ⟨lastCellInputBox values.1, lastCellInputBox values.2.1, lastCellInputBox values.2.2⟩

private def lastCellPanelEndpoints : Vector (ℤ × ℤ) 7 := #v[
  (361777753668733632, 361777753668776467),
  (1839070103713277132, 1839070104158915388),
  (99736632093137100, 99736632540827831),
  (3564753176867051, 3564753628463207),
  (79570636270238, 79571095696675),
  (1043272360106, 1043748458578),
  (7243955745, 7758076982)
]

def psiLastCellPanelSnapshot (i : Fin 7) : QInterval :=
  lastCellInputBox (lastCellPanelEndpoints.get i)

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiLastCellGridInputs_checked (i : Fin 7) :
    psiPreciseGridChecks (psiLastCellNode i) ∧
      psiPreciseGridInputs (psiLastCellNode i) = psiLastCellGridInputs i := by
  fin_cases i <;> decide +kernel

#print axioms psiLastCellGridInputs_checked

end Nuttall
