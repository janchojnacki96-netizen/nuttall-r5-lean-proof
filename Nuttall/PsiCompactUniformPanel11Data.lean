def psiOneUniformPanel11 : QInterval :=
  bounds 33102266626863158144082 33102266626863601240092

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (11/32) ∧ psiPreciseGridInputs (11/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel11Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel11Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel11Jet j).ContainsReal (iteratedDeriv j Phi ((11/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel11_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel11Jet 36 (1/32)
    psiOneUniformPanel11.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel11.hi := by
  decide +kernel

#print axioms psiOneUniformPanel11Jet_containsReal
#print axioms psiOneUniformPanel11_checked

