def psiOneUniformPanel6 : QInterval :=
  bounds 3180572211723588816199739 3180572211723589259222654

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (6/32) ∧ psiPreciseGridInputs (6/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel6Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel6Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel6Jet j).ContainsReal (iteratedDeriv j Phi ((6/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel6_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel6Jet 36 (1/32)
    psiOneUniformPanel6.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel6.hi := by
  decide +kernel

#print axioms psiOneUniformPanel6Jet_containsReal
