def psiOneUniformPanel13Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel13 : QInterval :=
  bounds 1477888053985543376363 1477888053985986853232

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (13/32) ∧ psiPreciseGridInputs (13/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel13Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel13Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel13Jet j).ContainsReal (iteratedDeriv j Phi ((13/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel13_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel13Jet 36 (1/32)
    psiOneUniformPanel13.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel13.hi := by
  decide +kernel

/-- One more shared anchor to the left of 14/32, at 13/32. -/
def psiOneCompactAnchor13 : QInterval :=
  psiOneCompactAnchor14.add psiOneUniformPanel13

theorem psiOneCompactAnchor13_containsReal :
    psiOneCompactAnchor13.ContainsReal (psi 1 ((13/32:ℚ):ℝ)) := by
  have hright : psiOneCompactAnchor14.ContainsReal (psi 1 (((14:ℕ):ℝ)/32)) := by
    simpa only [show ((14:ℕ):ℝ)/32 = ((14/32:ℚ):ℝ) by norm_num] using psiOneCompactAnchor14_containsReal
  have h := psiOneCompactShortPanel_containsReal (center := 13/32) (anchor := 14)
    (by norm_num) (by norm_num) (by decide) hright psiOneUniformPanel13Jet_containsReal
  rw [show ((14:ℕ):ℚ)/32-13/32 = 1/32 by norm_num, psiOnePanelBox_eq_add_zero] at h
  have hb := psiOneUniformPanel13_checked
  exact compactContainsReal_of_endpoints (add_le_add (le_refl psiOneCompactAnchor14.lo) hb.1)
    (add_le_add (le_refl psiOneCompactAnchor14.hi) hb.2) h

#print axioms psiOneUniformPanel13Jet_containsReal
#print axioms psiOneUniformPanel13_checked
#print axioms psiOneCompactAnchor13_containsReal

