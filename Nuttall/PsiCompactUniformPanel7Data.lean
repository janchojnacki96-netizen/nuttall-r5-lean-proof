def psiOneUniformPanel7Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel7 : QInterval :=
  bounds 1703310396830695152645727 1703310396830695595604794

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (7/32) ∧ psiPreciseGridInputs (7/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel7Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel7Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel7Jet j).ContainsReal (iteratedDeriv j Phi ((7/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel7_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel7Jet 36 (1/32)
    psiOneUniformPanel7.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel7.hi := by
  decide +kernel

#print axioms psiOneUniformPanel7Jet_containsReal
#print axioms psiOneUniformPanel7_checked

