def psiOneUniformPanel14Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel14 : QInterval :=
  bounds 215206179010300811589 215206179010744672418

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (14/32) ∧ psiPreciseGridInputs (14/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel14Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel14Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel14Jet j).ContainsReal (iteratedDeriv j Phi ((14/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel14_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel14Jet 36 (1/32)
    psiOneUniformPanel14.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel14.hi := by
  decide +kernel

/-- One more shared anchor to the left of 15/32, at 14/32. -/
def psiOneCompactAnchor14 : QInterval :=
  psiOneCompactFifteen32Anchor.add psiOneUniformPanel14

theorem psiOneCompactAnchor14_containsReal :
    psiOneCompactAnchor14.ContainsReal (psi 1 ((14/32:ℚ):ℝ)) := by
  have hright : psiOneCompactFifteen32Anchor.ContainsReal (psi 1 (((15:ℕ):ℝ)/32)) := by
    simpa only [show ((15:ℕ):ℝ)/32 = ((15/32:ℚ):ℝ) by norm_num] using psiOneCompactFifteen32Anchor_containsReal
  have h := psiOneCompactShortPanel_containsReal (center := 14/32) (anchor := 15)
    (by norm_num) (by norm_num) (by decide) hright psiOneUniformPanel14Jet_containsReal
  rw [show ((15:ℕ):ℚ)/32-14/32 = 1/32 by norm_num, psiOnePanelBox_eq_add_zero] at h
  have hb := psiOneUniformPanel14_checked
  exact compactContainsReal_of_endpoints (add_le_add (le_refl psiOneCompactFifteen32Anchor.lo) hb.1)
    (add_le_add (le_refl psiOneCompactFifteen32Anchor.hi) hb.2) h

#print axioms psiOneUniformPanel14Jet_containsReal
#print axioms psiOneUniformPanel14_checked
#print axioms psiOneCompactAnchor14_containsReal

