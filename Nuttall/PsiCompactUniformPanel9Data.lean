set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel9Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel9Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel9Jet j).ContainsReal (iteratedDeriv j Phi ((9/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel9_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel9Jet 36 (1/32)
