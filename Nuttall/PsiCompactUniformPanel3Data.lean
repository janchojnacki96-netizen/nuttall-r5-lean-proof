def psiOneUniformPanel3Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel3 : QInterval :=
  bounds 10887093481970458589144105 10887093481970459032298622

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (3/32) ∧ psiPreciseGridInputs (3/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel3Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel3Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel3Jet j).ContainsReal (iteratedDeriv j Phi ((3/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel3_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel3Jet 36 (1/32)
    psiOneUniformPanel3.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel3.hi := by
  decide +kernel

#print axioms psiOneUniformPanel3Jet_containsReal
#print axioms psiOneUniformPanel3_checked

