def psiOneUniformPanel5Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel5 : QInterval :=
  bounds 5296560427281669758114001 5296560427281670201166934

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (5/32) ∧ psiPreciseGridInputs (5/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel5Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel5Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel5Jet j).ContainsReal (iteratedDeriv j Phi ((5/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel5_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel5Jet 36 (1/32)
    psiOneUniformPanel5.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel5.hi := by
  decide +kernel

#print axioms psiOneUniformPanel5Jet_containsReal
#print axioms psiOneUniformPanel5_checked

