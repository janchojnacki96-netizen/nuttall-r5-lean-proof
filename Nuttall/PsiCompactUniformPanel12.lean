def psiOneUniformPanel12Jet (j : ℕ) : QInterval :=
  let e := endpoints.toArray[j]!
  bounds e.1 e.2

def psiOneUniformPanel12 : QInterval :=
  bounds 7842402306082890003138 7842402306083333245523

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem inputCheck :
    psiPreciseGridChecks (12/32) ∧ psiPreciseGridInputs (12/32) = gridInputs := by
  decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
private theorem jetCheck (j : ℕ) (hj : j < 36) :
    psiOneUniformPanel12Jet j = psiFixedGridPhiJetBoxOfInputs gridInputs j := by
  interval_cases j <;> decide +kernel

theorem psiOneUniformPanel12Jet_containsReal (j : ℕ) (hj : j < 36) :
    (psiOneUniformPanel12Jet j).ContainsReal (iteratedDeriv j Phi ((12/32:ℚ):ℝ)) := by
  rw [jetCheck j hj]
  exact psiFixedGridPhiJetBoxOfInputs_containsReal (by norm_num) (by norm_num)
    inputCheck.1 inputCheck.2 j

set_option maxRecDepth 65536 in
set_option maxHeartbeats 45000000 in
theorem psiOneUniformPanel12_checked :
    let raw := psiOnePanelBox (QInterval.point 0) psiOneUniformPanel12Jet 36 (1/32)
    psiOneUniformPanel12.lo ≤ raw.lo ∧ raw.hi ≤ psiOneUniformPanel12.hi := by
  decide +kernel

/-- One more shared anchor to the left of 13/32, at 12/32. -/
def psiOneCompactAnchor12 : QInterval :=
  psiOneCompactAnchor13.add psiOneUniformPanel12

theorem psiOneCompactAnchor12_containsReal :
    psiOneCompactAnchor12.ContainsReal (psi 1 ((12/32:ℚ):ℝ)) := by
  have hright : psiOneCompactAnchor13.ContainsReal (psi 1 (((13:ℕ):ℝ)/32)) := by
    simpa only [show ((13:ℕ):ℝ)/32 = ((13/32:ℚ):ℝ) by norm_num] using psiOneCompactAnchor13_containsReal
  have h := psiOneCompactShortPanel_containsReal (center := 12/32) (anchor := 13)
    (by norm_num) (by norm_num) (by decide) hright psiOneUniformPanel12Jet_containsReal
  rw [show ((13:ℕ):ℚ)/32-12/32 = 1/32 by norm_num, psiOnePanelBox_eq_add_zero] at h
  have hb := psiOneUniformPanel12_checked
  exact compactContainsReal_of_endpoints (add_le_add (le_refl psiOneCompactAnchor13.lo) hb.1)
    (add_le_add (le_refl psiOneCompactAnchor13.hi) hb.2) h

#print axioms psiOneUniformPanel12Jet_containsReal
#print axioms psiOneUniformPanel12_checked
#print axioms psiOneCompactAnchor12_containsReal

